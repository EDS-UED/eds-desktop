{
  "$description": "Motion Semantic — 4 大类场景 class（Ease / Layout / Flotation / Deform + 状态 modifier）。业务只选场景；勿改 base/recipe。引用：@eds/desktop-tokens/motion/semantic",
  "groups": [
    {
      "comment": "1 · Ease（缓入缓出 · 挂状态 modifier）",
      "styles": [
        {
          "title": "Ease — 基类（与 .is-paint-fade / .is-paint / .is-enter-only / .is-asym 组合）",
          "className": "motion-ease",
          "properties": {},
          "stateStyles": [
            {
              "hostClass": "motion-ease.is-paint-fade",
              "title": "a · paint + fade 对称入出",
              "properties": {
                "transition": "var(--motion-recipe-hover), var(--motion-recipe-fade)"
              },
              "notes": ["eds-hover-tooltip-trigger--focus"]
            },
            {
              "hostClass": "motion-ease.is-paint",
              "title": "b · paint 对称入出",
              "properties": { "transition": "var(--motion-recipe-hover)" }
            },
            {
              "hostClass": "motion-ease.is-enter-only",
              "title": "c · 仅入场",
              "properties": {
                "transition": "var(--motion-recipe-hover-asym)",
                "transition-duration": "0ms"
              },
              "pseudoStyles": [
                {
                  "selector": ":focus, :focus-visible, :active",
                  "properties": { "transition": "none" }
                },
                {
                  "selector": ":hover:not(:active):not(:focus-visible)",
                  "properties": {
                    "transition-duration": "var(--motion-duration-hover-asym)",
                    "transition-timing-function": "var(--motion-easing-enter)"
                  }
                }
              ],
              "notes": [
                "EgMotionHoverEnter · 仅 hover 入场 600ms；mouseleave / focus / active / 点按 无过渡"
              ]
            },
            {
              "hostClass": "motion-ease.is-asym",
              "title": "d · 悬浮入场（非对称 enter/exit）",
              "properties": { "transition": "var(--motion-recipe-hover-asym)" },
              "pseudoStyles": [
                {
                  "selector": ":hover, :focus-visible, :active",
                  "properties": { "transition-timing-function": "var(--motion-easing-enter)" }
                }
              ],
              "notes": ["Detail 关闭按钮等"]
            }
          ]
        }
      ]
    },
    {
      "comment": "2 · Layout（大位移动效）",
      "styles": [
        {
          "title": "大位移 · Drawer / Panel 等",
          "className": "motion-layout",
          "activeModifier": "is-active",
          "properties": {
            "transition": "var(--motion-recipe-enter)",
            "opacity": "var(--motion-opacity-hidden)",
            "transform": "translateY(var(--motion-offset-small))"
          },
          "activeState": {
            "opacity": "var(--motion-opacity-visible)",
            "transform": "translateY(0)"
          },
          "parentActiveSelectors": [".is-active", ".glassMicroFloatHostActive"],
          "selfActiveSelectors": [".glassMicroFloatHostActive"],
          "notes": ["默认自 bottom 入场；方向变体由 EDS glue 扩展"]
        }
      ]
    },
    {
      "comment": "3 · Flotation（微位移动效 · 浮层类）",
      "styles": [
        {
          "title": "Tooltip / Popover / Popup glass",
          "className": "motion-flotation",
          "activeModifier": "is-active",
          "properties": {
            "transition": "var(--motion-recipe-flotation-enter)",
            "opacity": "var(--motion-opacity-hidden)",
            "transform": "translateY(var(--motion-offset-flotation-y)) scale(var(--motion-scale-flotation-enter))"
          },
          "activeState": {
            "opacity": "var(--motion-opacity-visible)",
            "transform": "translateY(0) scale(1)"
          },
          "parentActiveSelectors": [".is-active", ".glassMicroFloatHostActive"],
          "selfActiveSelectors": [".glassMicroFloatHostActive"],
          "notes": ["glass 挂 motion-flotation；host 挂 is-active / glassMicroFloatHostActive"]
        }
      ]
    },
    {
      "comment": "4 · Deform（形变）",
      "styles": [
        {
          "title": "控件形变 · Tab / Toggle",
          "className": "motion-deform",
          "properties": { "transition": "var(--motion-recipe-control)" },
          "notes": ["非 enter/leave · 组件自身控制 transform"]
        }
      ]
    },
    {
      "comment": "5 · Page（页面切换）",
      "styles": [
        {
          "title": "页面切换 · macOS Navigation Push / Pop",
          "className": "motion-page",
          "properties": {
            "transition": "var(--motion-recipe-page-push)"
          },
          "notes": [
            "Motion Page 体系：`.motion-page-stack` + `data-page-direction` + `.motion-layout-content`",
            "A→B 带返回的页面切换统一走 glue · `motionPageTransition.css` + `useMotionPageStack`"
          ]
        }
      ]
    },
    {
      "comment": "6 · Layout Deform（布局形态 · 浮层容器尺寸 morph）",
      "styles": [
        {
          "title": "布局形态 · Tooltip / Popover 多页容器尺寸变化",
          "className": "motion-layout-deform",
          "properties": {
            "overflow": "hidden",
            "transition": "var(--motion-recipe-layout-deform-shell)"
          },
          "notes": [
            "浮层 shell：固定宽 + overflow hidden；A↔B 宽/高 morph 350ms · ease-8",
            "内层 content 挂 `.motion-layout-content` + `useMotionLayoutContentSwitch`"
          ]
        }
      ]
    },
    {
      "comment": "7 · Layout Content（同壳内容切换 · crossfade）",
      "styles": [
        {
          "title": "内容切换 · Detail Tab / Segmented / Popover 内页",
          "className": "motion-layout-content",
          "properties": {
            "transition": "var(--motion-recipe-layout-deform-content)",
            "opacity": "var(--motion-opacity-visible)",
            "transform": "translateY(0)"
          },
          "notes": [
            "同壳换内容 · translateY(+offset) crossfade；无 shell morph 时单独使用",
            "Glue：`.is-exiting` / `.is-entering` + `useMotionLayoutContentSwitch` · 120ms mid-swap",
            "Layout Deform / Motion Page 内层 content 亦挂本 class"
          ]
        }
      ]
    }
  ],
  "utilityClasses": [
    {
      "title": "None — 无过渡",
      "className": "motion-none",
      "standaloneTransition": "none",
      "notes": ["Focus / Selected"]
    }
  ],
  "reducedMotionScenarioClasses": [
    "motion-ease.is-paint-fade",
    "motion-ease.is-paint",
    "motion-ease.is-enter-only",
    "motion-ease.is-asym",
    "motion-layout",
    "motion-flotation",
    "motion-deform",
    "motion-page",
    "motion-layout-deform",
    "motion-layout-content"
  ]
}
