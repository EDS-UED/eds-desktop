{
  "$description": "Motion Base — primitive only（duration / easing / opacity / scale / offset）。无场景语义。引用：@eds/desktop-tokens/motion/base",
  "groups": [
    {
      "comment": "Duration（时长阶梯 · --eds-motion-N）",
      "tokens": {
        "eds-motion-0": "0ms",
        "eds-motion-1": "100ms",
        "eds-motion-2": "150ms",
        "eds-motion-3": "200ms",
        "eds-motion-4": "300ms",
        "eds-motion-5": "600ms",
        "eds-motion-6": "500ms",
        "eds-motion-7": "700ms",
        "eds-motion-8": "250ms",
        "eds-motion-9": "350ms",
        "eds-motion-10": "800ms",
        "eds-motion-11": "2000ms",
        "eds-motion-12": "180ms"
      },
      "usageNotes": [
        "0 = instant / focus / reduced-motion",
        "4 = 默认 hover（300ms）",
        "8 = Toggle / Tab 滑块（250ms）",
        "12 = Layout Deform 内容 crossfade",
        "10–11 = Spinner 周期"
      ]
    },
    {
      "comment": "Easing（缓动曲线 · --eds-motion-ease-N）",
      "tokens": {
        "eds-motion-ease-1": "ease-in-out",
        "eds-motion-ease-2": "cubic-bezier(0.2, 0, 0, 1)",
        "eds-motion-ease-3": "cubic-bezier(0.4, 0, 1, 1)",
        "eds-motion-ease-4": "cubic-bezier(0.4, 0, 0.2, 1)",
        "eds-motion-ease-5": "linear",
        "eds-motion-ease-6": "cubic-bezier(0.34, 1.4, 0.64, 1)",
        "eds-motion-ease-7": "cubic-bezier(0.34, 1.45, 0.64, 1)",
        "eds-motion-ease-8": "cubic-bezier(0.22, 1, 0.36, 1)",
        "eds-motion-ease-9": "cubic-bezier(0.16, 1, 0.3, 1)",
        "eds-motion-ease-10": "cubic-bezier(0.3, 0, 0.8, 0.15)",
        "eds-motion-ease-11": "cubic-bezier(0.12, 0.8, 0.2, 1)",
        "eds-motion-ease-12": "cubic-bezier(0.2, 0.8, 0.2, 1)"
      },
      "usageNotes": [
        "ease-1 = 缓入缓出（对称 hover，默认）",
        "ease-4 = Material · ease-5 = 线性（Spinner）",
        "ease-6/7 = 弹性反馈 · ease-8 = 减速渐隐"
      ]
    },
    {
      "comment": "Primitive State（物理量 — 无场景语义）",
      "tokenList": [
        { "name": "motion-opacity-hidden", "value": "0" },
        { "name": "motion-opacity-visible", "value": "1" },
        { "name": "motion-scale-small", "value": "0.95" },
        { "name": "motion-scale-flotation-enter", "value": "0.96", "comment": "Flotation 入场 scale" },
        { "name": "motion-offset-small", "value": "var(--spacing-2)", "comment": "8px · shift" },
        { "name": "motion-offset-nudge-y", "value": "calc(-1 * var(--spacing-1-5))", "comment": "-6px · nudge（legacy）" },
        { "name": "motion-offset-flotation-y", "value": "calc(-1 * var(--spacing-2-5))", "comment": "-10px · Flotation 入场" },
        {
          "name": "motion-offset-page-enter-x",
          "value": "100%",
          "comment": "Motion Page Push · 新页从右侧进入"
        },
        {
          "name": "motion-offset-page-leave-x",
          "value": "18%",
          "comment": "Motion Page Push · 旧页 parallax 后退"
        },
        {
          "name": "motion-offset-page-content-enter",
          "value": "calc(var(--spacing-5) + var(--spacing-05))",
          "comment": "22px · Motion Page content parallax 进入"
        },
        {
          "name": "motion-offset-page-content-leave",
          "value": "var(--spacing-2)",
          "comment": "8px · Motion Page content parallax 离开"
        },
        {
          "name": "motion-opacity-page-enter-from",
          "value": "0.96",
          "comment": "Motion Page Push · 新页起始 opacity"
        },
        {
          "name": "motion-opacity-page-leave-to",
          "value": "0.94",
          "comment": "Motion Page Push · 旧页结束 opacity"
        },
        { "name": "motion-offset-layout-deform-y", "value": "var(--spacing-2-5)", "comment": "10px · Layout Deform 内容 vertical nudge（Popover crossfade）" },
        {
          "name": "motion-offset-page-content-y-pop",
          "value": "0",
          "comment": "Motion Page Pop · 内层 content 纵移；0 = 返回时不上下挪"
        }
      ]
    }
  ]
}
