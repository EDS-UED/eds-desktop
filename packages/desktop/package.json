{
  "name": "@eds-evergreen/desktop",
  "version": "0.1.8",
  "description": "EverGreen Design System (Desktop) — tokens, animations, components, patterns, workflows",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/assemble.mjs",
    "typecheck": "echo \"Assembled from workspace packages\""
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/EDS-UED/eds-desktop.git",
    "directory": "packages/desktop"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./animations": {
      "import": "./dist/animations/index.js",
      "types": "./dist/animations/index.d.ts"
    },
    "./animations/style.css": "./dist/animations/index.css",
    "./components": {
      "import": "./dist/components/index.js",
      "types": "./dist/components/index.d.ts"
    },
    "./components/style.css": "./dist/components/index.css",
    "./patterns": {
      "import": "./dist/patterns/index.js",
      "types": "./dist/patterns/index.d.ts"
    },
    "./workflows": {
      "import": "./dist/workflows/index.js",
      "types": "./dist/workflows/index.d.ts"
    },
    "./tokens": "./dist/tokens/css/index.css",
    "./tokens/scale": "./dist/tokens/css/scale/index.css",
    "./tokens/scale/base": "./dist/tokens/css/scale/base.css",
    "./tokens/scale/semantic": "./dist/tokens/css/scale/semantic.css",
    "./tokens/typography": "./dist/tokens/css/typography/index.css",
    "./tokens/typography/base": "./dist/tokens/css/typography/base.css",
    "./tokens/typography/semantic": "./dist/tokens/css/typography/semantic.css",
    "./tokens/typography/bar-subpixel": "./dist/tokens/css/typography/bar-subpixel.css",
    "./tokens/text": "./dist/tokens/css/text/index.css",
    "./tokens/text/styles": "./dist/tokens/css/text/styles.css",
    "./tokens/fonts": "./dist/tokens/css/typography/fonts.css",
    "./tokens/motion": "./dist/tokens/css/motion/index.css",
    "./tokens/motion/base": "./dist/tokens/css/motion/base.css",
    "./tokens/motion/recipe": "./dist/tokens/css/motion/recipe.css",
    "./tokens/motion/semantic": "./dist/tokens/css/motion/semantic.css",
    "./tokens/motion/utilities": "./dist/tokens/css/motion/utilities.css",
    "./tokens/effect": "./dist/tokens/css/effect/index.css",
    "./tokens/effect/light": "./dist/tokens/css/effect/themes/light.css",
    "./tokens/effect/dark": "./dist/tokens/css/effect/themes/dark.css",
    "./tokens/effect/ready": "./dist/tokens/css/effect/ready.css",
    "./tokens/liquid-glass": "./dist/tokens/js/liquid-glass.js",
    "./tokens/corner-smoothing": "./dist/tokens/js/corner-smoothing.js",
    "./tokens/color": "./dist/tokens/css/color/index.css",
    "./tokens/color/light": "./dist/tokens/css/color/themes/light.css",
    "./tokens/color/dark": "./dist/tokens/css/color/themes/dark.css",
    "./tokens/tag": "./dist/tokens/css/color/tag/index.css",
    "./tokens/tag/light": "./dist/tokens/css/color/tag/themes/light.css",
    "./tokens/tag/dark": "./dist/tokens/css/color/tag/themes/dark.css",
    "./tokens/json": "./dist/tokens/json/tokens.json"
  }
}
