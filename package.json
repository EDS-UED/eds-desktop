{
  "name": "eds-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "EverGreen Design System (Desktop) — Vue 3 component library with Figma-synced tokens",
  "scripts": {
    "dev": "pnpm --filter @eds/desktop-showcase dev",
    "dev:showcase": "pnpm --filter @eds/desktop-showcase dev",
    "dev:storybook": "pnpm --filter @eds/desktop-storybook dev",
    "build": "pnpm build:desktop",
    "build:tokens": "pnpm --filter @eds/desktop-tokens build",
    "build:animations": "pnpm --filter @eds/desktop-animations build",
    "build:components": "pnpm --filter @eds/desktop-components build",
    "build:patterns": "pnpm --filter @eds/desktop-patterns build",
    "build:workflows": "pnpm --filter @eds/desktop-workflows build",
    "build:desktop": "pnpm build:tokens && pnpm build:animations && pnpm build:components && pnpm build:patterns && pnpm build:workflows && pnpm --filter @eds-evergreen/desktop build",
    "publish:desktop": "pnpm build:desktop && pnpm --filter @eds-evergreen/desktop publish --access public",
    "sync": "node scripts/sync-local-consumers.mjs",
    "sync:list": "node scripts/sync-local-consumers.mjs --list",
    "sync:tokens": "pnpm --filter @eds/desktop-tokens sync:figma",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "i18n:showcase:extract": "pnpm --filter @eds/desktop-showcase i18n:extract",
    "i18n:showcase:prefill": "pnpm --filter @eds/desktop-showcase i18n:prefill"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.15.4"
}
